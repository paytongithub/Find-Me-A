<Page x:Class="FindMeA_.Views.WelcomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FindMeA_.Views"
        mc:Ignorable="d"
        Title="WelcomePage" Height="800" Width="450">
    <Grid VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
           
            <!-- LOGO -->
            <StackPanel HorizontalAlignment="Center">
                <Ellipse Width="150" Height="150" Fill="#222">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#3e3a39" BlurRadius="20"/>
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Text="FIND ME A"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0 -110 0 0"/>
            </StackPanel>
            
            <!-- Tagline -->
            <TextBlock Text="What Will Be Your Next Watch?"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0 20 0 10"/>
            
            <!-- Buttons -->
            <Button Content="Sign Up"
                    Width="250" Height="45"
                    Background="#c5a85c"
                    Foreground="#3e3a39"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Style="{StaticResource RoundedButton}"
                    Margin="0 10"
                    Click="SignUp_Click"/>

            <Button Content="Log In"
                    Width="250" Height="45"
                    Background="#222"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="#444"
                    Style="{StaticResource RoundedButton}"
                    Margin="0 10"
                    Click="LogIn_Click"/>

            <Button Content="Continue as Guest"
                    Width="250" Height="45"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Margin="0 10"
                    Click="Guest_Click"/>
            
        </StackPanel>
        
    </Grid>
</Page>
