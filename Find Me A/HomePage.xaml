<Page x:Class="Find_Me_A.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FindMeA_.Views"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="450"
      Title="HomePage">

    <Page.Resources>
        <!-- Horizontal Scrolling Layout-->
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
           <!-- Poster Template -->
        <DataTemplate x:Key="PosterTemplate">
            <Border Width="140" Height="210" Margin="10" CornerRadius="8">
                <Image Source="{Binding}" Stretch="Fill"/>
            </Border>
        </DataTemplate>
        
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="FIND ME A"
                       FontSize="32"
                       Foreground="#D4AF37"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Welcome User"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0 0 20 0"/>

                <Button Content="Find Me A..."
                        Background="#D4AF37"
                        Foreground="Black"
                        Padding="10 5"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Style="{StaticResource RoundedButton}"/>
                
            </StackPanel>
        </DockPanel>
        <!-- Search Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 20">
            <TextBox Width="300"
                     Height="38"
                     FontSize="12"
                     Padding="10"
                     Background="#222"
                     Foreground="White"
                     BorderBrush="#444"
                     BorderThickness="1"
                     
                     Text="Search movies, shows, genres..."/>
            <Button Content="Search"
                    Width="100"
                    Height="38"
                    Margin="10 0"
                    Background="#D4AF37"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Style="{StaticResource RoundedButton}"/>
        </StackPanel>
        
        <!-- Featured For You-->
        <StackPanel Grid.Row="2" Margin="0 0 0 20">
            <TextBlock Text="Featured For You"
                       FontSize="22"
                       Foreground="White"
                       Margin="0 0 0 10"/>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="FeaturedItems"
                              ItemTemplate="{StaticResource PosterTemplate}"
                              ItemsPanel="{StaticResource HorizontalItemsPanel}"/>
            </ScrollViewer>
        </StackPanel>
        <!-- Top Picks -->
        <StackPanel Grid.Row="3" Margin="0 0 0 20">
            <TextBlock Text="Top Picks For You"
                       FontSize="22"
                       Foreground="White"
                       Margin="0 0 0 10"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="TopPicksItems"
                              ItemTemplate="{StaticResource PosterTemplate}"
                              ItemsPanel="{StaticResource HorizontalItemsPanel}"/>
            </ScrollViewer>
        </StackPanel>
        
        <!-- Trending Now -->
        <StackPanel Grid.Row="4" Margin="0 0 0 20">
            <TextBlock Text="Trending Now"
                       FontSize="22"
                       Foreground="White"
                       Margin="0 0 0 10"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="TrendingItems"
                              ItemTemplate="{StaticResource PosterTemplate}"
                              ItemsPanel="{StaticResource HorizontalItemsPanel}"/>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Page>
