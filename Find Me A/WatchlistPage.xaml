<Page x:Class="FindMeA_.Views.WatchlistPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FindMeA_.Views"
        mc:Ignorable="d"
        Title="WatchlistPage" Height="800" Width="450">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- LOGO + SEARCH -->
            <DockPanel Margin="0 10 0 20">

                <!-- Logo -->
                <TextBlock Text="FIND ME A"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left"/>

                <!-- Search Button -->
                <Button Content="Search"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"
                        Background="#222"
                        Foreground="White"
                        BorderBrush="#444"
                        FontWeight="Bold"
                        Click="Search_Click"/>
            </DockPanel>


            <!-- WATCHLIST SECTION -->
            <TextBlock Text="Watchlist"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 10 0 10"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Height="220">
                <ItemsControl x:Name="WatchlistItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 20 0">
                                <Image Width="110"
                                       Height="160"
                                       Stretch="UniformToFill"
                                       Source="{Binding Poster}"/>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           Width="110"
                                           Margin="0 10 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>



            <!-- COMING SOON SECTION -->
            <TextBlock Text="Coming Soon"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 30 0 10"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Height="220">
                <ItemsControl x:Name="ComingSoonItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 20 0">
                                <Image Width="110"
                                       Height="160"
                                       Stretch="UniformToFill"
                                       Source="{Binding Poster}"/>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           Width="110"
                                           Margin="0 10 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>



            <!-- BECAUSE YOU ADDED SECTION -->
            <TextBlock x:Name="BecauseHeader"
                       Text="Because You Added: Stranger Things"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 30 0 10"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Height="220">
                <ItemsControl x:Name="BecauseItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 20 0">
                                <Image Width="110"
                                       Height="160"
                                       Stretch="UniformToFill"
                                       Source="{Binding Poster}"/>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           Width="110"
                                           Margin="0 10 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </ScrollViewer>
</Page>
